local.properties

# Neural model/runtime artifacts are fetched or generated locally and verified by SHA-256.
/PitchKit/src/main/assets/crema/*.onnx
/PitchKit/src/main/assets/crema/*.bin
/PitchKit/src/main/assets/crema/*runtime-state*.json
/PitchKit/src/main/assets/chordnet/*.onnx
/PitchKit/src/main/assets/chordnet/*.bin
/PitchKit/src/main/assets/btc/*.onnx
/PitchKit/src/main/assets/btc/*.bin
/PitchKit/src/main/assets/btc/*.properties
/PitchKit/src/main/assets/lvchordia/*.onnx
/PitchKit/src/main/assets/lvchordia/*.bin
/PitchKit/src/main/assets/lvchordia/*.json
/PitchKit/src/main/assets/solitito/*.onnx
/PitchKit/src/main/assets/solitito/*.bin
/PitchKit/src/main/assets/solitito/*.json
/PitchKit/src/main/assets/consonance/*.onnx
/PitchKit/src/main/assets/consonance/*.bin
/PitchKit/src/main/assets/consonance/*.json

# Additional locally generated research model artifacts.
/PitchKit/src/main/assets/animechord/*.onnx
/PitchKit/src/main/assets/animechord/*.bin
/PitchKit/src/main/assets/chordformer/*.onnx
/PitchKit/src/main/assets/chordformer/*.bin

# ChordFormer has no licence, so nothing derived from it is published here. These are
# written by tools/accuracy_audit/export_chordformer.py in the Chordwell checkout
# (tools/restore-chordformer-assets.ps1 there restores the last committed copies).
/PitchKit/src/main/assets/chordformer/*.json
/PitchKit/src/test/resources/chordformer-decoder-fixture.json

# Fixtures computed from private reference songs, used only for local parity checks.
# The published anime fixtures are the animechord-synthetic-* files, made from
# generated audio by tools/generate-animechord-cqt-plans.py in the Chordwell checkout.
/PitchKit/src/test/resources/animechord-cqt-audio.s16
/PitchKit/src/test/resources/animechord-cqt-expected.f32
/PitchKit/src/test/resources/animechord-cqt-provenance.json
/PitchKit/src/test/resources/animechord-window.json
/PitchKit/src/test/resources/animechord-window-*.f32
